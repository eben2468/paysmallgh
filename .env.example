# PaySmallSmall environment config. Copy to .env and fill in.

APP_NAME="PaySmallSmall"
APP_URL=http://localhost/payss/public
APP_DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=paysmallsmall
DB_USER=root
DB_PASS=

# mock | sandbox | live
# mock:    payments succeed instantly against the local simulator. Demo-safe, no keys needed.
# sandbox: real Paystack API calls with TEST keys (sk_test_...). No real money.
# live:    real Paystack API calls with LIVE keys (sk_live_...).
PAYMENTS_MODE=mock

# ---- Paystack (payments: collections, merchant payouts, refunds) ----
# Dashboard -> Settings -> API Keys & Webhooks. The secret key also signs webhooks.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS
# Channels offered on hosted checkout (comma list). Empty = your dashboard default.
PAYSTACK_CHANNELS=mobile_money,card
# Customers sign up by phone; Paystack needs an email, so we send <phone>@this-domain.
PAYSTACK_EMAIL_DOMAIN=paysmallsmall.com
# A checkout nobody paid for is closed after this many hours so the plan isn't stuck.
PAYSTACK_PENDING_EXPIRY_HOURS=24
# Set this webhook URL in the Paystack dashboard: https://your-domain/webhook/paystack
# Reconcile pending payments older than this many minutes (status-check fallback)
RECONCILE_AFTER_MINUTES=2

# ---- SMS (Moolre — Paystack has no SMS product) ----
# live = real Moolre SMS (needs VAS key + approved Sender ID); mock = log only;
# unset = follow PAYMENTS_MODE.
SMS_MODE=mock
MOOLRE_BASE_URL=https://api.moolre.com
# SMS VAS key — from your Moolre dashboard. Required for live SMS.
MOOLRE_VAS_KEY=
# Approved Sender ID (max 11 chars). Must be registered/approved in Moolre.
MOOLRE_SMS_SENDER=PaySmall
MOOLRE_PATH_SMS=/open/sms/send
MOOLRE_PATH_SMS_STATUS=/open/sms/status

# Fees, in percent
PLATFORM_FEE_PCT=5
CANCEL_FEE_PCT=5

# Grace period for missed payments, in days
GRACE_DAYS=3

# How long a login lasts, in days. The clock resets on every visit, so people
# stay signed in until they log out themselves or stay away this long.
SESSION_LIFETIME_DAYS=30

# Admin login. Use the admin's REAL phone: it also gets a "new shop waiting
# for approval" SMS every time a merchant registers or asks for review again.
ADMIN_PHONE=233000000000
ADMIN_PASSWORD=change-me

# USSD short code shown on the site (assigned by Moolre)
USSD_CODE=*920*77#
